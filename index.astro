---
import Layout from '../layouts/Layout.astro';
import { navigationRegistry } from '../data/navigation';

const calculators = navigationRegistry.filter(r => r.category === 'calculator');
const games       = navigationRegistry.filter(r => r.category === 'game');
---

<Layout title="Home">

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="bg-white border border-slate-200 rounded-xl shadow-sm px-8 py-10 mb-2">
    <h1 class="text-3xl font-semibold text-slate-900 tracking-tight mb-2">Tools &amp; Games Hub</h1>
    <p class="text-slate-500 text-base leading-relaxed max-w-2xl">
      A growing collection of fast, free micro-apps — precision calculators and engaging browser games,
      all in one place. No installs, no sign-ups.
    </p>
  </section>

  <!-- ── Calculators ───────────────────────────────────── -->
  <section>
    <h2 class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4 px-1">Calculators</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
      {calculators.map(app => (
        <a
          href={`/${app.slug}`}
          data-coming-soon
          class="group bg-white border border-slate-200 rounded-xl shadow-sm px-5 py-4 flex items-center gap-4 hover:border-indigo-300 hover:shadow-md transition-all cursor-pointer"
        >
          <span class="text-2xl select-none" aria-hidden="true">{app.icon}</span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-slate-900 group-hover:text-indigo-600 transition-colors truncate">{app.name}</p>
            <p class="text-xs text-slate-400 mt-0.5">Calculator</p>
          </div>
          <svg class="text-slate-300 group-hover:text-indigo-400 transition-colors flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Games ─────────────────────────────────────────── -->
  <section>
    <h2 class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4 px-1">Games</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
      {games.map(app => (
        <a
          href={`/${app.slug}`}
          data-coming-soon
          class="group bg-white border border-slate-200 rounded-xl shadow-sm px-5 py-4 flex items-center gap-4 hover:border-indigo-300 hover:shadow-md transition-all cursor-pointer"
        >
          <span class="text-2xl select-none" aria-hidden="true">{app.icon}</span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-slate-900 group-hover:text-indigo-600 transition-colors truncate">{app.name}</p>
            <p class="text-xs text-slate-400 mt-0.5">Game</p>
          </div>
          <svg class="text-slate-300 group-hover:text-indigo-400 transition-colors flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Coming-soon inline state card ─────────────────── -->
  <div
    id="coming-soon-card"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="coming-soon-title"
  >
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xl px-10 py-10 max-w-sm w-full mx-4 text-center">
      <div class="w-14 h-14 rounded-full bg-indigo-50 flex items-center justify-center mx-auto mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <h3 id="coming-soon-title" class="text-lg font-semibold text-slate-900 mb-2">Coming Soon!</h3>
      <p class="text-sm text-slate-500 leading-relaxed mb-6">
        Our development engine is compiling this micro-app next. Check back shortly — new tools drop regularly.
      </p>
      <button
        id="coming-soon-dismiss"
        class="w-full px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2"
        type="button"
      >
        Got it
      </button>
    </div>
  </div>

  <slot name="description">
    <p>
      Tools &amp; Games Hub is your go-to destination for free online calculators and browser-based games.
      Our ever-expanding library covers everyday math utilities, date and time calculators, unit converters,
      financial estimators, and a variety of skill and strategy games — all optimised for speed, accuracy, and ease of use.
      No downloads required; simply visit, play, and calculate directly in your browser.
    </p>
  </slot>

</Layout>

<script>
  // Intercept "coming soon" links and show the inline state card instead of navigating
  const card    = document.getElementById('coming-soon-card')!;
  const dismiss = document.getElementById('coming-soon-dismiss')!;

  document.querySelectorAll<HTMLAnchorElement>('a[data-coming-soon]').forEach(link => {
    link.addEventListener('click', (e: MouseEvent) => {
      e.preventDefault();
      card.classList.remove('hidden');
      dismiss.focus();
    });
  });

  function closeCard(): void {
    card.classList.add('hidden');
  }

  dismiss.addEventListener('click', closeCard);

  // Close on backdrop click
  card.addEventListener('click', (e: MouseEvent) => {
    if (e.target === card) closeCard();
  });

  // Close on Escape key
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && !card.classList.contains('hidden')) closeCard();
  });
</script>
