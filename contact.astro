---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">

  <div class="max-w-xl mx-auto">

    <!-- Page header -->
    <div class="mb-8">
      <h1 class="text-2xl font-semibold text-slate-900 tracking-tight mb-1">Contact Us</h1>
      <p class="text-sm text-slate-500">Have a question, suggestion, or bug to report? We read every message.</p>
    </div>

    <!-- Contact form card -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm px-8 py-8">
      <div id="contact-form-container">
        <!-- Using div + buttons instead of <form> for full JS control and SPA-friendliness -->
        <div class="flex flex-col gap-5">

          <!-- Email -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-email" class="text-sm font-medium text-slate-700">
              Email Address <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
              class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-slate-50 border border-slate-200 rounded-lg placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-shadow"
            />
            <p id="contact-email-error" class="text-xs text-red-500 hidden">Please enter a valid email address.</p>
          </div>

          <!-- Message type -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-type" class="text-sm font-medium text-slate-700">
              Message Type <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <select
              id="contact-type"
              required
              class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-shadow appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Select a message type…</option>
              <option value="general">General Enquiry</option>
              <option value="bug">Bug Report</option>
              <option value="feature">Feature Request</option>
              <option value="business">Business &amp; Partnership</option>
              <option value="other">Other</option>
            </select>
            <p id="contact-type-error" class="text-xs text-red-500 hidden">Please select a message type.</p>
          </div>

          <!-- Comments -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-message" class="text-sm font-medium text-slate-700">
              Comments <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <textarea
              id="contact-message"
              rows="5"
              placeholder="Tell us what's on your mind…"
              required
              class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-slate-50 border border-slate-200 rounded-lg placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-shadow resize-y"
            ></textarea>
            <p id="contact-message-error" class="text-xs text-red-500 hidden">Please enter your message (minimum 10 characters).</p>
          </div>

          <!-- Submit -->
          <button
            id="contact-submit"
            type="button"
            class="w-full sm:w-auto sm:self-end inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2"
          >
            Send Message
          </button>

        </div>
      </div>

      <!-- Success state — shown after submission -->
      <div id="contact-success" class="hidden flex-col items-center text-center gap-4 py-6">
        <div class="w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <div>
          <h2 class="text-base font-semibold text-slate-900 mb-1">Message Received!</h2>
          <p class="text-sm text-slate-500 max-w-xs mx-auto leading-relaxed">
            Thank you for reaching out. We'll get back to you at the address provided as soon as possible.
          </p>
        </div>
        <button
          id="contact-reset"
          type="button"
          class="mt-2 text-sm text-indigo-600 hover:underline focus:outline-none"
        >
          Send another message
        </button>
      </div>
    </div>

  </div>

  <!-- SEO / crawler context slot -->
  <div slot="description">
    <p>
      Reach the Tools &amp; Games Hub team via this contact form. We welcome bug reports, feature suggestions,
      partnership enquiries, and general feedback to help us improve our free online tools and browser games.
    </p>
  </div>

</Layout>

<script>
  const emailEl   = document.getElementById('contact-email')   as HTMLInputElement;
  const typeEl    = document.getElementById('contact-type')    as HTMLSelectElement;
  const messageEl = document.getElementById('contact-message') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('contact-submit')  as HTMLButtonElement;
  const formContainer = document.getElementById('contact-form-container') as HTMLDivElement;
  const successBox    = document.getElementById('contact-success')        as HTMLDivElement;
  const resetBtn      = document.getElementById('contact-reset')          as HTMLButtonElement;

  const emailError   = document.getElementById('contact-email-error')   as HTMLParagraphElement;
  const typeError    = document.getElementById('contact-type-error')    as HTMLParagraphElement;
  const messageError = document.getElementById('contact-message-error') as HTMLParagraphElement;

  function validateEmail(value: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  }

  function showError(el: HTMLParagraphElement, show: boolean): void {
    el.classList.toggle('hidden', !show);
  }

  function validate(): boolean {
    let valid = true;

    const emailOk = validateEmail(emailEl.value.trim());
    showError(emailError, !emailOk);
    if (!emailOk) valid = false;

    const typeOk = typeEl.value !== '';
    showError(typeError, !typeOk);
    if (!typeOk) valid = false;

    const msgOk = messageEl.value.trim().length >= 10;
    showError(messageError, !msgOk);
    if (!msgOk) valid = false;

    return valid;
  }

  submitBtn.addEventListener('click', () => {
    if (!validate()) return;

    // In a real deployment, replace this block with a fetch() to your form endpoint
    // (e.g. Cloudflare Workers, Formspree, EmailJS, etc.)
    console.info('Contact form payload:', {
      email:   emailEl.value.trim(),
      type:    typeEl.value,
      message: messageEl.value.trim(),
    });

    formContainer.classList.add('hidden');
    successBox.classList.remove('hidden');
    successBox.classList.add('flex');
  });

  resetBtn.addEventListener('click', () => {
    emailEl.value   = '';
    typeEl.value    = '';
    messageEl.value = '';
    [emailError, typeError, messageError].forEach(el => el.classList.add('hidden'));

    successBox.classList.add('hidden');
    successBox.classList.remove('flex');
    formContainer.classList.remove('hidden');
    emailEl.focus();
  });
</script>
